[alias]
        co = checkout
        d = diff --exit-code
        st = status
        b = branch
        last = log -1 --stat
        cp = cherry-pick
        lol = log --oneline --graph
        cl = clone
        ci = commit
        br = branch
        unstage = reset HEAD --
        dc = diff --cached
        lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %Cblue<%an>%Creset' --abbrev-commit --date=relative --all
[core]
        editor = \"vim\"
        trustctime = false
        filemode = false
[color]
        diff = auto
        status = auto
        branch = auto
        interactive = auto
        ui = true
        pager = true
[user]
	email = miguelmail@gmail.com
	name = miguel
[cola]
	spellcheck = false
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[filter "strongbox"]
	clean = strongbox -clean %f
	smudge = strongbox -smudge %f
	required = true
[diff "strongbox"]
	textconv = strongbox -diff

#[url "git@github.com:"]
    #insteadOf = https://github.com/
